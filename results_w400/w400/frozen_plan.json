 "preprocessing": "targets and features z-scored within subject x speed x leg; features clipped at +-5 SD; per target, strides with |target z| > 4 dropped; missing EEG features = 0 after z-scoring",
 "model": {
  "m0": "RidgeCV, alphas logspace(-2, 4, 25), efficient leave-one-out (GCV)",
  "eeg_stage": "EEG made orthogonal to M0 by least squares on the training subjects; RidgeCV, alphas logspace(0, 6, 25), on the M0 training residuals; prediction = M0 + EEG stage"
 },
 "cv": "each confirm subject held out once; training = all other primary-set subjects (dev and confirm)",
 "metric": "per held-out subject: delta R2 = R2(M0 + EEG stage) - R2(M0), R2 relative to the trial mean (= 0)",
 "primary": {
  "variant": "trial-centered",
  "test": "one-sided Wilcoxon signed-rank, delta R2 > 0, over the 33 confirm subjects",
  "alpha": 0.05,
  "multiplicity": "Holm over the 3 targets"
 },
 "equivalence": {
  "sesoi_delta_r2": 0.01,
  "test": "one-sided Wilcoxon, delta R2 - 0.01 < 0, Holm over the 3 targets",
  "claim_if_significant": "EEG did not improve held-out prediction by delta R2 >= 0.01"
 },
 "estimates": "median delta R2 with bootstrap 95% CI over subjects (4000 resamples, seed 20261009); M0 R2 reported as the mechanics baseline",
 "secondary": [
  "stride-to-stride variant (first differences within trial), same model and tests",
  "circular-shift null of the median delta R2 (each trial's EEG rotated by >= 3 strides; 100 rotations)",
  "window [-600, -100] ms (sensitivity)",
  "relaxed tier + odd-mapping trials added (sensitivity)",
  "cross-speed: train on two speeds of the training subjects, test on the third speed of the held-out subject",
  "per leg and per speed (descriptive)",
  "broadband-power model and dose-response vs artifact index (descriptive)",
  "CNN on the pre-landing EEG predicting the M0 residuals, same two-stage logic and circular control (after the primary test)"
 ],
